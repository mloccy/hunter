cmake_minimum_required(VERSION 3.10)
project(Hunter)

include("@HUNTER_SELF@/cmake/Hunter")

include(hunter_internal_error)
include(hunter_user_error)
include(hunter_status_debug)
include(hunter_assert_not_empty_string)
include(ExternalProject) # ExternalProject_Add

hunter_status_debug("Scheme: url_sha1_meson")

# Check preconditions
hunter_assert_not_empty_string("@HUNTER_SELF@")
hunter_assert_not_empty_string("@HUNTER_EP_NAME@")
hunter_assert_not_empty_string("@HUNTER_PACKAGE_URL@")
hunter_assert_not_empty_string("@HUNTER_PACKAGE_SHA1@")
hunter_assert_not_empty_string("@HUNTER_PACKAGE_DOWNLOAD_DIR@")
hunter_assert_not_empty_string("@HUNTER_PACKAGE_SOURCE_DIR@")
hunter_assert_not_empty_string("@HUNTER_PACKAGE_BUILD_DIR@")
hunter_assert_not_empty_string("@HUNTER_PACKAGE_INSTALL_PREFIX@")
hunter_assert_not_empty_string("@HUNTER_INSTALL_PREFIX@")

hunter_add_package(hunter_venv)
find_package(hunter_venv CONFIG REQUIRED)
hunter_add_package(pip_meson)

foreach(dependency ${DEPENDS_ON_PACKAGES})
  hunter_add_package(${dependency})
endforeach()

if (NOT WIN32)
    find_program(NINJA_BUILD ninja)
    if (NOT NINJA_BUILD)
        hunter_add_package(ninja-build)
        find_program(NINJA_BUILD ninja REQUIRED)

    endif()
endif()

set(previous_project "")

set(_meson_path ${HUNTER_INSTALL_PREFIX}/bin:$ENV{PATH})
set(native_file_path "@HUNTER_PACKAGE_DOWNLOAD_DIR@/meson-native.ini")
file(WRITE ${native_file_path} "[binaries]\n")
file(APPEND "${native_file_path}" "python = '${Python3_EXECUTABLE}'\n")
set(meson_configure_args "")

if (MESON_NATIVE_PROGRAMS_OVERRIDES_HINTS AND MESON_NATIVE_PROGRAMS_OVERRIDES_INI_NAMES)
    list(LENGTH MESON_NATIVE_PROGRAMS_OVERRIDES_HINTS length_1)
    list(LENGTH MESON_NATIVE_PROGRAMS_OVERRIDES_INI_NAMES length_2)
    if (NOT ${length_1} EQUAL ${length_2})
        hunter_internal_error(
            "Improper configuration:
            MESON_NATIVE_PROGRAMS_OVERRIDES_HINTS and
            MESON_NATIVE_PROGRAMS_OVERRIDES_INI_NAMES must have the same length.")
    endif()

    math(EXPR loop_end "${length_1} - 1")

    foreach (idx RANGE 0 ${loop_end})
        list(GET MESON_NATIVE_PROGRAMS_OVERRIDES_HINTS ${idx} loop_hint)
        list(GET MESON_NATIVE_PROGRAMS_OVERRIDES_INI_NAMES ${idx} loop_name)
        find_program(${loop_name}_PROGRAM_PATH ${loop_hint} REQUIRED)
        file(APPEND "${native_file_path}" "${loop_name} = '${${loop_name}_PROGRAM_PATH}'\n")
    endforeach()
endif()

set(additional_setup_args "")
set(MSVC_SETUP_STEP "")
if (MSVC)
    list(APPEND MSVC_SETUP_STEP "@HUNTER_MSVC_VCVARSALL@")
    list(APPEND MSVC_SETUP_STEP @HUNTER_MSVC_ARCH@)
    list(APPEND additional_setup_args --backend=vs)
endif()

set(MESON_C_LINK_ARGS_REGEX "^c_link_args=([a-zA-Z0-9\+,=-]+)$")
set(MESON_BUILD_DIR "@HUNTER_PACKAGE_BUILD_DIR@/MesonBuild")
set(MESON_PACKAGE_SETS_C_ARGS FALSE)
set(LIBRARY_DIR "@HUNTER_PACKAGE_INSTALL_PREFIX@/lib")
if (MESON_CONFIGURE_OPTIONS)
string(REPLACE " " ";" MESON_ADDITIONAL_ARG_LIST ${MESON_CONFIGURE_OPTIONS})
hunter_status_debug("ADDITIONAL MESON OPTIONS: ${MESON_ADDITIONAL_ARG_LIST}")

    list(LENGTH MESON_ADDITIONAL_ARG_LIST _MESON_NUM_ADDITIONAL_ARGS)
    math(EXPR MESON_NUM_ADDITIONAL_ARGS "${_MESON_NUM_ADDITIONAL_ARGS} - 1")
    foreach (idx RANGE ${MESON_NUM_ADDITIONAL_ARGS})
        list(GET MESON_ADDITIONAL_ARG_LIST ${idx} opt)
        string(REGEX MATCH "${MESON_C_LINK_ARGS_REGEX}" option_matched "${opt}")
        hunter_status_debug("MESON OPT: ${opt}")
        if (option_matched)
            set(MESON_PACKAGE_SETS_C_ARGS TRUE)
            set(meson_c_link_args "")

            if (MESON_ADDITIONAL_LINK_LIBRARIES)
                string(JOIN " -l" meson_c_link_args ${MESON_ADDITIONAL_LINK_LIBRARIES})
                set(meson_c_link_args "-l${meson_c_link_args}")
                set(meson_c_link_args "-L${LIBRARY_DIR} ${meson_c_link_args}")
            else()
                set(meson_c_link_args "-L${LIBRARY_DIR}")
            endif()

            set(meson_c_link_args "${meson_c_link_args} ${CMAKE_MATCH_1}")

            list(APPEND meson_configure_args "-Dc_link_args=${meson_c_link_args}")
        else()
            list(APPEND meson_configure_args "-D${opt}")
        endif()
    endforeach()
endif()

if (NOT MESON_PACKAGE_SETS_C_ARGS AND MESON_ADDITIONAL_LINK_LIBRARIES)
    string(JOIN " -l" meson_c_link_args ${MESON_ADDITIONAL_LINK_LIBRARIES})
    set(meson_c_link_args "-l${meson_c_link_args}")
    set(meson_c_link_args "-L${LIBRARY_DIR} ${meson_c_link_args}")
    list(APPEND meson_configure_args "-Dc_link_args=${meson_c_link_args}")
endif()

if (BUILD_SHARED_LIBS)
    list(APPEND meson_configure_args "-Ddefault_both_libraries=shared")
else()
    list(APPEND meson_configure_args "-Ddefault_both_libraries=static")
endif()

set(configuration_types "@HUNTER_PACKAGE_CONFIGURATION_TYPES@")
list(LENGTH configuration_types len)
if(NOT len EQUAL "1")
  hunter_internal_error("Meson builds only support a single configuration")
else()
  set(no_postfix FALSE)
endif()

list(GET configuration_types 0 configuration)

string(TOUPPER "${configuration}" configuration_upper)
string(COMPARE EQUAL "${configuration_upper}" "RELEASE" is_release)

set(meson_build_type "release")

if (NOT is_release)
    set(meson_build_type "debug")
endif()

if (is_release)
    list(APPEND meson_configure_args "-Ddebug=false")
else()
    list(APPEND meson_configure_args "-Ddebug=true")
endif()

list(APPEND meson_configure_args "-Dbuildtype=${meson_build_type}")

ExternalProject_Add(
        "@HUNTER_EP_NAME@"
    URL
        "@HUNTER_PACKAGE_URL@"
    URL_HASH
        SHA1=@HUNTER_PACKAGE_SHA1@
    DOWNLOAD_EXTRACT_TIMESTAMP
        TRUE
    TLS_VERIFY
        "@HUNTER_TLS_VERIFY@"
    DOWNLOAD_DIR
        "@HUNTER_PACKAGE_DOWNLOAD_DIR@"
    SOURCE_DIR
        "@HUNTER_PACKAGE_SOURCE_DIR@"
    INSTALL_DIR
    "@HUNTER_PACKAGE_INSTALL_PREFIX@"
    CONFIGURE_COMMAND
        ${MSVC_SETUP_STEP}
    COMMAND
        ${CMAKE_COMMAND} -E env PATH=${_meson_path} ${Python3_EXECUTABLE} -m mesonbuild.mesonmain setup --native-file "${native_file_path}" --libdir lib --prefix @HUNTER_PACKAGE_INSTALL_PREFIX@ ${additional_setup_args} -Dcmake_prefix_path=@HUNTER_PACKAGE_INSTALL_PREFIX@/lib/cmake ${meson_configure_args} "${MESON_BUILD_DIR}"
    BUILD_COMMAND
        ${CMAKE_COMMAND} -E env PATH=${_meson_path} ${Python3_EXECUTABLE} -m mesonbuild.mesonmain compile -C "${MESON_BUILD_DIR}" -j@HUNTER_JOBS_OPTION@
    BUILD_IN_SOURCE
        1
    INSTALL_COMMAND
        ${CMAKE_COMMAND} -E env PATH=${_meson_path} ${Python3_EXECUTABLE} -m mesonbuild.mesonmain install -C "${MESON_BUILD_DIR}")
